{% extends 'partials/base.html.twig' %}

{% block content %}
    <article class="single-post">
        <h1>{{ page.title }}</h1>
        <p class="date-published">Published on: {{ page.date|date("F j, Y") }}</p>
        
        <div class="post-content">
            {{ page.content|raw }}
        </div>
    </article>
{% endblock %}