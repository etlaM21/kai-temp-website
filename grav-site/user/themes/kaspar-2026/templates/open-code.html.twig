{% extends 'partials/base.html.twig' %}

{% block content %}
    <div class="project-wrapper">
        <h1>K.ai</h1>
        {{ page.header.content_sections.k_ai|markdown }}

        <h1>Code</h1>
        {{ page.header.content_sections.code|markdown }}

        <h1>Documentation</h1>
        {{ page.header.content_sections.documentation|markdown }}

        {% if page.collection|length > 0 %}
            <h1>Latest Tutorials</h1>
            {% for tutorial in page.collection %}
                <h2><a href="{{ tutorial.url }}">{{ tutorial.title }}</a></h2>
                <p class="date">{{ tutorial.date|date("M d, Y") }}</p>
                <p>{{ tutorial.summary(150) }}</p>
            {% endfor %}
        {% endif %}
    </div>
{% endblock %}
