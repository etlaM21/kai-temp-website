O:39:"Grav\Common\Flex\Types\Pages\PageObject":4:{s:4:"type";s:5:"pages";s:3:"key";s:17:"home/_description";s:8:"elements";a:4:{s:4:"root";b:0;s:6:"header";a:1:{s:5:"title";s:19:"Minimal Description";}s:11:"frontmatter";s:28:"title: 'Minimal Description'";s:8:"markdown";s:551:"The Residenztheater München presents a radical reimagining of Peter Handke’s Kaspar by integrating a Large Language Model directly into the live rehearsal and performance process. In this digital-age laboratory, the AI acts as the modern prompter, subjecting the protagonist to a visceral cycle of algorithmic speech torture and synthetic socialization. This production marks a haunting collision between avant-garde theater and 21st-century code, questioning what remains of the human soul when our very thoughts are shaped by predictive patterns.";}s:7:"storage";a:6:{s:3:"key";s:17:"home/_description";s:11:"storage_key";s:20:"01.home/_description";s:8:"template";s:4:"text";s:17:"storage_timestamp";i:1774301858;s:8:"markdown";a:1:{s:0:"";a:1:{s:4:"text";i:1774301858;}}s:8:"checksum";s:32:"81d364b1e7479f25edafb127612043cc";}}